# ---------------------------------------------------------------------------
# TravelX environment variables
# ---------------------------------------------------------------------------
# The public site needs NONE of these — it builds and runs with zero config.
# These only enable EDITING content at /keystatic on your DEPLOYED site.
# Locally, /keystatic works with no env vars (local file mode).
#
# Add the chosen values in Vercel (Settings → Environment Variables) and, for
# local testing, copy them into a .env.local (git-ignored).
# ---------------------------------------------------------------------------

# === Option A: Keystatic Cloud (RECOMMENDED — no GitHub App, no secrets) =====
# Create a project at https://keystatic.cloud, connect your repo, then set:
NEXT_PUBLIC_KEYSTATIC_CLOUD_PROJECT=      # e.g. travel-x/travelx

# === Option B: Self-hosted GitHub App mode (alternative to Cloud) ============
# Set ALL FIVE together, or none. Requires a GitHub App (see README) with
# "User-to-server token expiration" ENABLED. If Cloud (above) is set, these
# are ignored.
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=        # "owner/repo"  (case-sensitive!)
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=                         # random 40+ chars, e.g. `openssl rand -hex 32`
