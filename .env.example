# ---------------------------------------------------------------------------
# TravelX environment variables
# ---------------------------------------------------------------------------
# The public site needs NONE of these — it builds and runs with zero config.
# These only enable EDITING content at /keystatic on your DEPLOYED site
# (GitHub storage mode). Locally, /keystatic works with no env vars (local mode).
#
# Copy to .env.local for local GitHub-mode testing, and add the same values in
# your Vercel project settings (Settings → Environment Variables).
#
# Until ALL of these are set, Keystatic stays in local mode and the build is
# unaffected. See the README "Editing content on the live site" section.
# ---------------------------------------------------------------------------

# Your GitHub repo that holds this project, as "owner/repo"
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=

# The GitHub App you create for Keystatic (see README):
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Any random 40+ character string (e.g. `openssl rand -hex 32`)
KEYSTATIC_SECRET=
